{
  "name": "dueling-team",
  "productName": "Dueling Team",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first Yu-Gi-Oh-style TCG simulator (portfolio project, non-commercial).",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @duel/client dev",
    "import:cards": "tsx scripts/import-cards.ts",
    "import:sets": "tsx scripts/import-sets.ts",
    "import:banlists": "tsx scripts/update-banlists.ts",
    "import:banlists:legacy": "tsx scripts/import-banlists-legacy.ts",
    "import:genesys": "tsx scripts/update-genesys.ts",
    "import:genesys:history": "tsx scripts/import-genesys-history.ts",
    "build:images": "tsx scripts/build-image-pack.ts",
    "build:set-images": "tsx scripts/build-set-images.ts",
    "fill:set": "tsx scripts/fill-set.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "vitest": "^1.6.0"
  }
}
